[unlock-dialog-background]
picture-uri='/home/abdallah-shehawey/Pictures/Naruto.jpg'
picture-uri-dark='/home/abdallah-shehawey/Pictures/Naruto.jpg'

[vitals]
alphabetize=true
fan-colors=@as []
fixed-widths=true
hide-icons=false
hide-zeros=true
hot-sensors=['__temperature_avg__', '_gpu#1_temperature_', '_gpu#1_utilization_']
icon-style=1
menu-centered=true
position-in-panel=0
show-battery=true
show-gpu=true
show-sensor-history-graph=true
