+impl DesktopFont {
+    /// The family GNOME's `org.gnome.desktop.interface font-name` names, its faces as fontconfig
+    /// finds them, and the first face of fontconfig's list for that family's Arabic text that has
+    /// Arabic. `None` without the family or its regular face.
+    #[cfg(all(not(windows), not(target_os = "macos"), not(target_arch = "wasm32")))]
+    fn read() -> Option<DesktopFont> {
+        let family = desktop_family()?;
+        let escaped = fc_escape(&family);
+        let face = |pattern: &str| -> Option<(std::path::PathBuf, Arc<FontData>)> {
+            let path = fc_match_file(pattern, &family)?;
+            let bytes = read_font(&path, SYSTEM_FONT_CAP)?;
+            Some((path, Arc::new(FontData::from_owned(bytes))))
+        };
+        let (regular_path, regular) = face(&escaped)?;
+        let heavier = |weight: &str| face(&format!("{escaped}:weight={weight}")).filter(|(path, _)| *path != regular_path).map(|(_, data)| data);
+        let semibold = heavier("semibold");
+        let bold = heavier("bold");
+        let arabic = fc_script_file(&format!("{escaped}:lang=ar"), "ar")
+            .and_then(|path| read_font(&path, FALLBACK_FONT_CAP))
+            .map(|bytes| Arc::new(FontData::from_owned(bytes)));
+        Some(DesktopFont { family, regular, semibold, bold, arabic })
+    }
+}
