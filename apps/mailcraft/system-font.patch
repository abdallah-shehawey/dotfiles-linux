+/// What `program` prints, when it runs and succeeds.
+#[cfg(all(not(windows), not(target_os = "macos"), not(target_arch = "wasm32")))]
+fn command_output(program: &str, args: &[&str]) -> Option<String> {
+    let out = std::process::Command::new(program).args(args).stdin(std::process::Stdio::null()).stderr(std::process::Stdio::null()).output().ok()?;
+    out.status.success().then(|| String::from_utf8_lossy(&out.stdout).into_owned())
+}
+
+/// The family of the desktop's interface font, from GNOME's setting ("'PoetsenOne 10'"), without
+/// its size or font variations.
+#[cfg(all(not(windows), not(target_os = "macos"), not(target_arch = "wasm32")))]
+fn desktop_family() -> Option<String> {
+    let raw = command_output("gsettings", &["get", "org.gnome.desktop.interface", "font-name"])?;
+    let name = raw.trim().trim_matches('\'');
+    let name = name.split(" @").next().unwrap_or(name).trim();
+    let name = match name.rsplit_once(' ') {
+        Some((family, size)) if size.parse::<f32>().is_ok() => family,
+        _ => name,
+    };
+    let name = name.trim().trim_end_matches(',').trim();
+    (!name.is_empty()).then(|| name.to_string())
+}
+
+/// `family` written so that fontconfig reads it as one family name.
+#[cfg(all(not(windows), not(target_os = "macos"), not(target_arch = "wasm32")))]
+fn fc_escape(family: &str) -> String {
+    let mut out = String::with_capacity(family.len());
+    for ch in family.chars() {
+        if matches!(ch, '\\' | '-' | ':' | ',') {
+            out.push('\\');
+        }
+        out.push(ch);
+    }
+    out
+}
+
+/// The file fontconfig picks for `pattern`, when the face it picks is of `family`.
+#[cfg(all(not(windows), not(target_os = "macos"), not(target_arch = "wasm32")))]
+fn fc_match_file(pattern: &str, family: &str) -> Option<std::path::PathBuf> {
+    let out = command_output("fc-match", &["-f", "%{family}\n%{file}", pattern])?;
+    let (families, file) = out.split_once('\n')?;
+    families.split(',').any(|f| f.trim().eq_ignore_ascii_case(family)).then(|| std::path::PathBuf::from(file.trim()))
+}
+
+/// The first face in fontconfig's fallback list for `pattern` that covers the language `lang`.
+#[cfg(all(not(windows), not(target_os = "macos"), not(target_arch = "wasm32")))]
+fn fc_script_file(pattern: &str, lang: &str) -> Option<std::path::PathBuf> {
+    let out = command_output("fc-match", &["-s", "-f", "%{lang}\t%{file}\n", pattern])?;
+    out.lines().filter_map(|line| line.split_once('\t')).find(|(langs, _)| langs.split('|').any(|l| l == lang)).map(|(_, file)| std::path::PathBuf::from(file.trim()))
+}
