+/// The font the window is drawn in (File › Options › General, `ui.interfaceFont`): MailCraft's
+/// own Inter, as a new installation starts, or the desktop's interface font where the desktop
+/// names one (GNOME's `font-name`, found through fontconfig), drawn as lightly as the desktop
+/// draws it.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+#[serde(from = "String", into = "String")]
+pub enum InterfaceFont {
+    #[default]
+    MailCraft,
+    Desktop,
+}
+
+impl InterfaceFont {
+    /// In menu order.
+    pub const ALL: [InterfaceFont; 2] = [InterfaceFont::MailCraft, InterfaceFont::Desktop];
+
+    /// The value used in `ui.json` and by the `ui.interfaceFont` command.
+    pub fn code(self) -> &'static str {
+        match self {
+            InterfaceFont::MailCraft => "mailcraft",
+            InterfaceFont::Desktop => "desktop",
+        }
+    }
+
+    pub fn from_code(code: &str) -> Option<InterfaceFont> {
+        InterfaceFont::ALL.into_iter().find(|f| f.code().eq_ignore_ascii_case(code.trim()))
+    }
+}
+
+impl From<String> for InterfaceFont {
+    fn from(s: String) -> Self {
+        InterfaceFont::from_code(&s).unwrap_or_default()
+    }
+}
+
+impl From<InterfaceFont> for String {
+    fn from(f: InterfaceFont) -> Self {
+        f.code().to_string()
+    }
+}
+
+/// How the desktop's font is drawn on the dark theme: the rasterizer's coverage as it is, as the
