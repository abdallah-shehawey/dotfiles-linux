+/// text: "Sent Items" in PoetsenOne carried 17% more ink per pixel of width than Pango and Cairo
+/// draw it on the desktop, and 0.6% less with the coverage as it is.
+const DESKTOP_DARK_TEXT: egui::epaint::FontColorTransferFunction = egui::epaint::FontColorTransferFunction::Off;
